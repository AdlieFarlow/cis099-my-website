body {

    background-color: #1a1a1a;
    color: #f2f2f2;
    font-family: Arial, sans-serif;
    margin: 0;
    line-height: 1.6;

}

header {

    background-color: #7b1e1e;
    color: white;
    text-align: center;
    padding: 30px;

}

header h1 {

    font-size: 40px;

}

nav {

    background-color: #333333;
    text-align: center;
    padding: 15px;

}

nav a {

    color: #e6b85c;
    text-decoration: none;
    margin: 15px;

}

nav a:hover {

    color: white;

}

section {

    background-color: #292929;
    margin: 25px;
    padding: 25px;
    border-radius: 10px;

}

h2 {

    color: #e6b85c;

}

img {

    width: 100%;
    max-width: 600px;
    display: block;
    margin: 20px auto;
    border-radius: 10px;

}

button {

    background-color: #7b1e1e;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;

}

button:hover {

    background-color: #a52a2a;

}

footer {

    text-align: center;
    padding: 20px;
    background-color: #333333;

}

footer a {

    color: #e6b85c;

}
